eading":{"gradient":true,"title":"Unlock your potential at Dean's University","cta":{"label":"","path":""}}},"variants":[{"audiences":["registeredForAnOpenDay"],"coursePicker":true,"bannerImage":{"src":"\u002Fimages\u002Fbanners\u002Fwhat-to-expect-on-an-open-day.xce3edf1e.png","alt":""},"heading":{"gradient":false,"title":"What to expect on an Open Day","cta":{"label":"Find out more","path":"\u002Fcontact-us\u002Fwhat-to-expect-on-an-open-day"}}},{"audiences":["prospectiveUndergraduateArtStudent"],"coursePicker":true,"bannerImage":{"src":"\u002Fimages\u002Fbanners\u002Farty-side-banner.xd95e97d3.png","alt":""},"heading":{"gradient":true,"title":"Unlock your arty side at Ludlow University","cta":{"label":"Book your place","path":"\u002Fundergraduate-study\u002Fopen-day-booking-form"}}},{"audiences":["returningProspectiveUndergraduate"],"coursePicker":true,"bannerImage":{"src":"\u002Fimages\u002Fbanners\u002Fvr-headset.x78a68c04.jpeg","alt":""},"heading":{"gradient":true,"title":"Welcome back! Get ready to discover your potential at Ludlow University.","cta":{"label":"","path":""}}}]},"composer":[{"_id":"featuredTestimonials-0","_type":"featuredTestimonials","value":{"featuredImage":{"src":"\u002Fimages\u002Ffeatured-content\u002Fmain\u002Fimg-1-2.x6b453fe4.png","alt":"\"\""},"secondaryImage":{"src":"\u002Fimages\u002Ffeatured-content\u002Fsecondary\u002Fmini-img-1.x83aa7a9d.jpg","alt":"\"\""},"info":{"testimonial":{"copy":"Ludlow gave me the perfect balance of independence and mentorship. I finished my PhD feeling well prepared for a career in academia and composition, and deeply grateful for the experience.","author":{"name":"Caleb Patel","avatar":"\u002Fimages\u002Fpeople\u002Fcaleb.x693da76b.jpg","lead":"Music PhD"}},"cta":{"label":"Read student stories","path":undefined},"richText":undefined,"title":undefined},"theme":"light","imageAlign":"Left"}},{"_id":"highlights-1","_type":"highlights","value":{"data":[{"title":"Study here","links":[{"title":"Undergraduate courses","path":"\u002Fcourses?courseLevel=f69decf6-67e9-477b-bbf5-4547eff52fbd"},{"title":"Postgraduate courses","path":"\u002Fcourses?courseLevel=9c2d2955-9566-41ee-9e20-fae7b627632c%2Cce731f6f-87ee-4c21-8d21-356bd07094cf"},{"title":"Research courses","path":"\u002Fcourses?courseLevel=3c6169c1-1ad2-428a-88b8-9476a5d5c6eb"}],"testimonial":{"author":{"name":"Abigail Nelson","avatar":"\u002Fimages\u002Fpeople\u002Fabigail.x830d0019.jpg","lead":"Accountancy BSc"},"copy":"I recently graduated with a degree in Accounting and I couldn't be happier with my decision. The program provided me with a solid foundation in financial analysis, bookkeeping, and tax preparation, which has allowed me to excel in my career. \nThe professors were knowledgeable and passionate, and the coursework was both challenging and engaging. I am grateful for the skills and knowledge I have acquired through this program and would highly recommend it to anyone looking to pursue a career in accounting."}},{"title":"Live here","links":[{"title":"Accommodation","path":"\u002Fstudent-life\u002Faccommodation"},{"title":"Clubs and Societies","path":"\u002Fstudent-stories"},{"title":"Local area","path":"\u002Fabout\u002Fhow-to-find-us"}],"testimonial":{"author":{"name":"Amina Hassan","avatar":"\u002Fimages\u002Fpeople\u002Famina.x3f3167b9.jpg","lead":"Computer Science BSc"},"copy":"Pursuing a degree in Computer Science has been one of the best decisions I have ever made. The program has opened up a world of opportunities for me and has equipped me with the necessary skills to succeed in a rapidly growing field. I have learned to think critically, solve problems and develop innovative solutions that can have a positive impact on society. The professors are knowledgeable, engaging and have real-world experience that they bring to the classroom. I am proud to have a degree in Computer Science and I highly recommend this program to anyone looking for a rewarding career path."}},{"title":"Succeed here","links":[{"title":"Great job prospects","path":"\u002Fstudent-stories"},{"title":"Keep learning"},{"title":"Hear from our alumni","path":"\u002Fstudent-stories"}],"testimonial":{"author":{"name":"Brandon Kim","avatar":"\u002Fimages\u002Fpeople\u002Fbrandon.x239b0b86.jpg","lead":"Artificial Intelligence BSc"},"copy":"Studying Artificial Intelligence at Ludlow University has been an extraordinary experience for me. The program is comprehensive and well-structured, covering a broad range of topics from machine learning and deep learning to natural language processing and computer vision. The faculty members are experts in their fields and have been incredibly supportive throughout my academic journey."}}]}},{"_id":"cardRow-2","_type":"cardRow","value":{"theme":"light","cards":[{"uri":"\u002Fcourses","title":"Browse our courses","lead":"Unlock your potential: Explore a world of knowledge with our diverse range of courses.","image":{"uri":"\u002Fimages\u002Fcards\u002Funi-friends.xfa7960d5.jpeg","alt":"Two smiling students in a workshop."}},{"uri":"\u002Fstudent-life","title":"Student life","lead":"Live student life to the fullest: Explore, engage, and excel at Ludlow University.","image":{"uri":"\u002Fimages\u002Fcards\u002Fstudent-cafe.x942e50ae.jpeg","alt":"A group of students and staff inside a coffee shop."}},{"uri":undefined,"title":"Our world famous research","lead":"Explore boundaries and break barriers: Welcome to the forefront of innovation at Ludlow University.","image":{"uri":"\u002Fimages\u002Fcards\u002Fbubbles.xba477749.jpeg","alt":"A slide depicting water droplets under different coloured lights."}}],"cardsRowTwo":[]}},{"_id":"personalisedEvent-3","_type":"personalisedEvent","value":{"defaultContent":{"heading":{"title":"Game Design Open Day","lead":"The perfect opportunity for prospective students to learn about the university, meet with current students and faculty, and get a feel for campus life. ","cta":{"label":"Book your place","path":"\u002Fevents\u002Fgam