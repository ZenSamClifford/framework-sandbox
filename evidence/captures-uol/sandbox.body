layName":"Open Day Booking Form","language":"en-GB","path":"\u002Fundergraduate-study\u002Fopen-day-booking-form","childCount":0,"children":[],"entry":{"sys":{"id":"78f402d3-fc3d-429d-a32b-5d8cd0548bf6","language":"en-GB","contentTypeId":"contentPage","dataFormat":"entry"}},"isCanonical":true,"version":{"versionNo":"1.0"},"includeInMenu":true},{"id":"5936f509-56f0-42f5-a365-b1f9a6cb2be7","parentId":"89f7ea0a-ea7e-4c1c-ba3d-0a59d453227c","projectId":"universityDemo","slug":"personal-support","displayName":"Personal support","language":"en-GB","path":"\u002Fundergraduate-study\u002Fpersonal-support","childCount":0,"children":[],"entry":{"sys":{"id":"b9691ce1-6025-4ad8-8289-4dd1bfe9adeb","language":"en-GB","contentTypeId":"contentPage","dataFormat":"entry"}},"isCanonical":true,"version":{"versionNo":"1.0"},"includeInMenu":true}],"entry":{"sys":{"id":"1a4a3934-08cc-4483-a052-3ad990107749","language":"en-GB","contentTypeId":"landingPage","dataFormat":"entry"}},"isCanonical":true,"version":{"versionNo":"1.0"},"includeInMenu":true}],"entry":{"sys":{"id":"8de402d6-574f-4786-8eb0-23628a0a8da5","language":"en-GB","contentTypeId":"personalisedLandingPage","dataFormat":"entry"}},"isCanonical":true,"version":{"versionNo":"5.0"},"includeInMenu":true},"error":{"isError":false,"message":null},"isReady":true},"routing":{"canonicalPath":"\u002Faccessibility","currentHostname":"staging-universitydemo-uol.cloud.contensis.com","currentPath":"\u002Faccessibility","currentNode":{"id":"b36fcb8a-5817-444e-b3f5-d361ba041ae6","parentId":"ed18076b-80c0-4b87-ad74-b00e7fb9a348","projectId":"universityDemo","slug":"accessibility","displayName":"Accessibility","language":"en-GB","path":"\u002Faccessibility","childCount":0,"children":[],"isCanonical":true,"version":{"versionNo":"1.0"},"includeInMenu":true},"currentNodeAncestors":[],"currentProject":"universityDemo","entryID":"5ba49eef-cff1-46b7-9767-1665f19257c2","entry":{"sys":{"dataFormat":"entry","contentTypeId":"contentPage","language":"en-GB","id":"5ba49eef-cff1-46b7-9767-1665f19257c2","uri":"\u002Faccessibility","versionStatus":"published"}},"error":undefined,"isError":false,"isLoading":false,"isLivePreview":false,"location":{"pathname":"\u002Faccessibility","search":"","hash":"","state":null,"key":"default"},"mappedEntry":{"title":"Accessibility","summary":"We are dedicated to ensuring equal access and inclusivity for all individuals, regardless of ability or disability.","content":[{"id":"ea019ea6","type":"_paragraph","value":"At Ludlow University, we are committed to ensuring that our website is accessible to all users, regardless of ability or disability. We strive to adhere to the Web Content Accessibility Guidelines (WCAG) 2.1, which provide standards for making web content more accessible for people with disabilities."},{"id":"39640e6c","type":"_paragraph","value":[{"id":"d2118bcb","type":"_fragment","value":"Accessibility Features","properties":{"decorators":["strong"]}}]},{"id":"d558a4ff","type":"_paragraph","value":"Here are some of the features we have implemented to make our website more accessible:"},{"id":"d04a9720","type":"_list","value":[{"id":"212e122d","type":"_listItem","value":[{"id":"65d8679","type":"_fragment","value":"Alternative Text for Images","properties":{"decorators":["strong"]}},{"id":"3f40629e","type":"_fragment","value":": We provide alternative text descriptions for all images on our website, ensuring that users with visual impairments can understand the content of the images."}]},{"id":"17febe19","type":"_listItem","value":[{"id":"a9af11c8","type":"_fragment","value":"Keyboard Navigation","properties":{"decorators":["strong"]}},{"id":"192bf0b3","type":"_fragment","value":": Our website can be fully navigated using only a keyboard, allowing users who cannot operate a mouse to access all content and features."}]},{"id":"5415eb0e","type":"_listItem","value":[{"id":"542d32ea","type":"_fragment","value":"Descriptive Links","properties":{"decorators":["strong"]}},{"id":"8db1a216","type":"_fragment","value":": We use descriptive link text to ensure that users using screen readers can understand the purpose of each link without having to read surrounding text."}]},{"id":"7de7bc95","type":"_listItem","value":[{"id":"f90463af","type":"_fragment","value":"Readable Text","properties":{"decorators":["strong"]}},{"id":"346e8a7d","type":"_fragment","value":": We have ensured that the text on our website is readable and adjustable. Users can easily increase or decrease the text size according to their preferences."}]},{"id":"7d41cd02","type":"_listItem","value":[{"id":"c18f7668","type":"_fragment","value":"Color Contrast","properties":{"decorators":["strong"]}},{"id":"58cdcc47","type":"_fragment","value":": We have paid attention to the color contrast of text and background elements to ensure readability for users with low vision or color blindness."}]},{"id":"fd51bf96","type":"_listItem","value":[{"id":"ac7ca05d","type":"_fragment","value":"Accessible Forms","properties":{"decorators":["strong"]}},{"id":"36095bca","type":"_fragment","value":": Our online forms are designed to be accessible to screen readers and are structured in a logical and intuitive manner."}]},{"id":"11bdb5da","type":"_listItem","value":[{"id":"24b4253f","type":"_fragment","value":"Video Captioning","properties":{"decorators":["strong"]}},{"id":"1968931e","type":"_fragment","value":": Videos on our website are captioned to ensure that users who are deaf or hard of hearing can access the content."}]}],"properties":{"listType":"ordered"}},{"id":"338b3237","type":"_paragraph","value":[{"id":"daa24a","type":"_fragment","value":"Feedback","properties":{"decorators":["strong"]}}]},{"id":"83a79769","type":"_paragraph","value":"We are continuously working to improve the accessibility of our website. If you encounter any accessibility barriers or have suggestions for improvement, please contact us at web@ludlow.ac.uk. Your feedback is valuable to us and will help us to enhance the accessibility of our website for all users."},{"id":"87dbb3be","type":"_paragraph","value":[{"id":"c67100be","type":"_fragment","value":"Accessibility Standards Compliance","properties":{"decorators":["strong"]}}]},{"id":"6921fd50","type":"_paragraph","value":"While we strive to adhere to the WCAG 2.1 guidelines and other accessibility standards, we acknowledge that there may be areas of our website that are not fully accessible. We are actively working to address these issues and improve the overall accessibility of our website."},{"id":"692815db","type":"_paragraph","value":[{"id":"5d7b7163","type":"_fragment","value":"Accessibility Resources","properties":{"decorators":["strong"]}}]},{"id":"a63a428a","type":"_paragraph","value":"For users seeking additional assistance with accessibility features, we recommend the following resources:"},{"id":"62d69b21","type":"_list","value":[{"id":"471b7974","type":"_listItem","value":[{"id":"12c6dfd6","type":"_link","value":"WebAIM","properties":{"link":{"sys":{"uri":"https:\u002F\u002Fwebaim.org\u002F","linkProperties":{"type":"uri"}}}}},{"id":"9fce3565","type":"_fragment","value":": Web Accessibility In Mind provides valuable resources and tools for web accessibility."}]},{"id":"33d29312","type":"_listItem","value":[{"id":"fbb615a5","type":"_link","value":"W3C Web Accessibility Initiative (WAI)","properties":{"link":{"sys":{"uri":"https:\u002F\u002Fwww.w3.org\u002FWAI\u002F","linkProperties":{"type":"uri"}}}}},{"id":"1ce479a0","type":"_fragment","value":": The WAI provides guidelines and resources for improving web accessibility."}]},{"id":"9f571b64","type":"_listItem","value":[{"id":"5e435334","type":"_link","value":"Lighthouse","properties":{"link":{"sys":{"uri":"https:\u002F\u002Fdevelopers.google.com\u002Fweb\u002Ftools\u002Flighthouse","linkProperties":{"type":"uri"}}}}},{"id":"cf65caca","type":"_fragment","value":": A tool provided by Google that can audit web pages for accessibility, performance, and more."}]}],"properties":{"listType":"unordered"}},{"id":"8ef68bc3","type":"_paragraph","value":[{"id":"184d7274","type":"_fragment","value":"Contact Information","properties":{"decorators":["strong"]}}]},{"id":"b30eb52e","type":"_paragraph","value":"If you have any questions or concerns regarding the accessibility of our website, please don't hesitate to contact us:"},{"id":"ba516a34","type":"_paragraph","value":"Ludlow University Address: Ludlow University, Ludlow, SY1 234 Phone: 01234567890 Email: web@ludlow.ac.uk"},{"id":"372377ad","type":"_paragraph","value":"Thank you for visiting the Ludlow University website. We are dedicated to providing an inclusive online experience for all users."}],"related":{"params":{"categories":""},"excludeIds":["5ba49eef-cff1-46b7-9767-1665f19257c2"]},"composer":[]},"notFound":false,"ssrHostname":"staging-universitydemo-uol.cloud.contensis.com","staticRoute":{"route":{"element":null}},"statusCode":200,"allowedGroups":undefined},"version":{"commitRef":"254da162b673aea821c4a9149d5f11647645d731","buildNo":"451723","contensisVersionStatus":"published"},"siteConfig":{"mappedEntry":{"title":"University of Leicester"},"isLoading":false,"isReady":true,"isError":false,"error":null}}</script> <script  src="/_saOKKg_432245b3-59f0-4dba-b7e9-f92a6bb32d14/static/startup-2.0.0.js"></script><script id="modern__LOADABLE_REQUIRED_CHUNKS__" type="application/json" type="module">[834,795,905]</script><script id="modern__LOADABLE_REQUIRED_CHUNKS___ext" type="application/json" type="module">{"namedChunks":["content.template","canvas","composer"]}</script>
